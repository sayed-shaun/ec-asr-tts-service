ZIPFORMER_MODEL_NAME=alphacep/vosk-model-small-streaming-bn

ZIPFORMER_PROVIDER=cuda

TTS_ENABLED=false

TTS_MODEL_NAME=ai4bharat/indic-parler-tts

HF_TOKEN=

TTS_VOICE=Aditi

TTS_MAX_CHARS=160

TTS_ATTN_IMPLEMENTATION=auto

TTS_CACHE_ENABLED=true

TTS_CACHE_MAX_MB=1024

ACCELERATOR=cuda

DEVICES=1

WORKERS_PER_DEVICE=2

TRANSCRIBE_BATCH_SIZE=4

SAMPLE_RATE=16000

LITSERVE_TIMEOUT=120.0

ITN_ENABLED=true

LITSERVE_BASE_URL=http://litserver:8000

LITSERVE_PORT=8000

CORS_ALLOW_ORIGINS=*

GATEWAY_PORT=8000

LOG_LEVEL=INFO
LOG_DIR=.logs
