# Copy to .env and adjust as needed.

# Hugging Face model id (NeMo FastConformer CTC checkpoint)
ASR_MODEL_NAME=hishab/titu_stt_bn_fastconformer

# "cpu" | "cuda"
ASR_ACCELERATOR=cuda

# Number of GPUs. "auto" relies on `nvidia-smi -L` working — if nvidia-smi is
# broken (NVML driver/library mismatch) even though torch.cuda works fine,
# "auto" silently resolves to 0 and crashes server.run(). Set the real count.
ASR_DEVICES=1

# Inference worker processes per device — each holds a full model copy in GPU
# memory. 2 is conservative for ~8-12GB GPUs; raise if nvidia-smi shows headroom.
ASR_WORKERS_PER_DEVICE=2

# Batch size for NeMo's transcribe() call across a single request's audio list
# (LitServe's own request-level batching is intentionally disabled — see lit_api.py)
ASR_TRANSCRIBE_BATCH_SIZE=4

# Audio
ASR_SAMPLE_RATE=16000

# Audio longer than this is split into consecutive chunks before transcription
# (avoids GPU OOM on long-form audio; this checkpoint trained on clips <=18.5s)
ASR_MAX_SEGMENT_SECONDS=18.0

# HTTP server
ASR_HOST=0.0.0.0
ASR_PORT=8000
ASR_API_PATH=/api/v1/asr/transcribe

# Logging
ASR_LOG_LEVEL=INFO
ASR_LOG_DIR=.logs
