# Copy to .env and adjust as needed.

# Hugging Face model id (NeMo FastConformer CTC checkpoint)
ASR_MODEL_NAME=hishab/titu_stt_bn_fastconformer

# Human-readable label for GET /v1/asr/info's "architecture" field. Set this
# alongside ASR_MODEL_NAME when you change it — it is not derived
# automatically, so /v1/asr/info reports the previous model's architecture
# until this is updated too. E.g. "Conformer-CTC Large (NeMo)" for
# hishab/titu_stt_bn_conformer_large.
ASR_MODEL_ARCHITECTURE=FastConformer-CTC (NeMo)

# "cpu" | "cuda"
ASR_ACCELERATOR=cuda

# Number of GPUs. "auto" relies on `nvidia-smi -L` working — if nvidia-smi is
# broken (NVML driver/library mismatch) even though torch.cuda works fine,
# "auto" silently resolves to 0 and crashes server.run(). Set the real count.
ASR_DEVICES=1

# Inference worker processes per device — each holds a full model copy in GPU
# memory. 2 is conservative for ~8-12GB GPUs; raise if nvidia-smi shows headroom.
ASR_WORKERS_PER_DEVICE=2

# Batch size for NeMo's transcribe() call across a single request's audio list
# (LitServe's own request-level batching is intentionally disabled — see lit_api.py)
ASR_TRANSCRIBE_BATCH_SIZE=4

# Audio
ASR_SAMPLE_RATE=16000

# Spectral-gating denoise (noisereduce, pip install ".[denoise]"). Off by
# default: measured on this pipeline's sample data it rewrote the transcript
# on every file (word count rose on all 8 files tested, 0 identical to
# undenoised) for an unverified net effect on accuracy (no ground truth WER).
# Enable only if your real input is noisier than clean-ish broadcast
# narration, and verify with actual WER before trusting it.
ASR_DENOISE=false

# stationary=true measured better on sample data (fewer invalid-orthography
# hits) but non-stationary is usually the correct choice for real recordings
# with time-varying background noise. Re-measure for your own input.
ASR_DENOISE_STATIONARY=true

# Audio longer than this is split into consecutive chunks before transcription
# (avoids GPU OOM on long-form audio; this checkpoint trained on clips <=18.5s)
ASR_MAX_SEGMENT_SECONDS=18.0

# HTTP server
ASR_HOST=0.0.0.0
ASR_PORT=8000
ASR_API_PATH=/api/v1/asr/transcribe

# live-cc: FINAL caption latency (chunks are hard cuts, no overlap)
ASR_LIVE_CC_CHUNK_SECONDS=3.0

# live-cc: how often (seconds of in-progress audio) to push an interim
# (is_final: false) caption by re-transcribing the whole in-progress chunk
# so far. Gives a live-updating feel without incremental decoding, at the
# cost of redundant recompute (roughly chunk_seconds / this, per chunk).
# Set to 0 to disable and only emit final captions.
ASR_LIVE_CC_INTERIM_INTERVAL_SECONDS=1.0

# live-cc: sample rate of the raw PCM the client actually streams over the
# WebSocket. Must match your real input source — mismatching this from
# SAMPLE_RATE mislabels the WAV header and corrupts playback speed rather
# than failing loudly.
ASR_LIVE_CC_INPUT_SAMPLE_RATE=8000

# Logging
ASR_LOG_LEVEL=INFO
ASR_LOG_DIR=.logs
