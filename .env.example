# Copy to .env and adjust as needed.

# Hugging Face model id (NeMo FastConformer CTC checkpoint)
ASR_MODEL_NAME=hishab/titu_stt_bn_fastconformer

# "auto" | "cpu" | "cuda" | "mps"
ASR_ACCELERATOR=auto

# Number of accelerator devices ("auto" or an int)
ASR_DEVICES=auto

# Inference worker processes per device
ASR_WORKERS_PER_DEVICE=1

# Batch size for NeMo's transcribe() call across a single request's audio list
# (LitServe's own request-level batching is intentionally disabled — see lit_api.py)
ASR_TRANSCRIBE_BATCH_SIZE=4

# Audio
ASR_SAMPLE_RATE=16000

# Audio longer than this is split into consecutive chunks before transcription
# (avoids GPU OOM on long-form audio; this checkpoint trained on clips <=18.5s)
ASR_MAX_SEGMENT_SECONDS=18.0

# HTTP server
ASR_HOST=0.0.0.0
ASR_PORT=8000
ASR_API_PATH=/predict

# Logging
ASR_LOG_LEVEL=INFO
ASR_LOG_DIR=log_folder
