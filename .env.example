MODEL_NAME=hishab/titu_stt_bn_fastconformer

ACCELERATOR=cuda

DEVICES=1

WORKERS_PER_DEVICE=2

TRANSCRIBE_BATCH_SIZE=4

SAMPLE_RATE=16000

DENOISE=false

DENOISE_STATIONARY=true

MAX_SEGMENT_SECONDS=18.0

GATEWAY_PORT=8000

LIVE_CC_CHUNK_SECONDS=3.0

LIVE_CC_INTERIM_INTERVAL_SECONDS=1.0

LIVE_CC_INPUT_SAMPLE_RATE=8000

SPEAKER_GATE_ENABLED=false
SPEAKER_ENROLL_SECONDS=3.0
SPEAKER_SIMILARITY_THRESHOLD=0.75

LOG_LEVEL=INFO
LOG_DIR=.logs
