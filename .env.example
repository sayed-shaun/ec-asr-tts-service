# Hugging Face checkpoint to load. Swap in hishab/titu_stt_bn_fastconformer
# for lower latency at the cost of accuracy (see outputs/benchmark_report.pdf).
MODEL_NAME=hishab/titu_stt_bn_conformer_large

# "cuda" or "cpu". Must match the hardware LitServe actually runs on.
ACCELERATOR=cuda

# GPU count. Pinned rather than "auto": LitServe's "auto" shells out to
# `nvidia-smi -L`, which can silently report 0 devices even when
# torch.cuda.is_available() is True, crashing server startup.
DEVICES=1

# Worker processes per GPU. Each holds a full model copy in GPU memory;
# 2 is conservative for ~8-12GB GPUs — lower it if you hit OOM.
WORKERS_PER_DEVICE=2

# Max utterances batched together per inference call.
TRANSCRIBE_BATCH_SIZE=4

# Expected input sample rate (Hz) for /predict.
SAMPLE_RATE=16000

# Longer audio is split into non-overlapping segments of this length and
# rejoined. This checkpoint trained on clips up to ~18.5s; longer inputs
# blow up the encoder's attention memory.
MAX_SEGMENT_SECONDS=18.0

# Public port for the gateway (main.py). LitServe's own host/port are
# hardcoded elsewhere (run_litserve.py, src/api/client.py) — not configurable.
GATEWAY_PORT=8000

# Live-caption chunk length (seconds) — final caption latency, hard cuts, no overlap.
LIVE_CC_CHUNK_SECONDS=3.0

# How often (seconds) to re-transcribe the in-progress chunk for interim
# captions. GPU cost scales as chunk_seconds / this value. 0 disables interim captions.
LIVE_CC_INTERIM_INTERVAL_SECONDS=1.0

# Raw PCM sample rate (Hz) the live-cc client actually streams — must match
# the client, not SAMPLE_RATE above.
LIVE_CC_INPUT_SAMPLE_RATE=8000

LOG_LEVEL=INFO
LOG_DIR=.logs
