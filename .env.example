# Which engine backs /predict: "conformer" (NeMo FastConformer CTC),
# "wav2vec2" (HuggingFace Wav2Vec2 CTC), or "whisper" (HuggingFace Whisper
# seq2seq).
ENGINE=conformer

# Hugging Face checkpoint to load when ENGINE=conformer. MIT-licensed,
# commercial-use-safe (unlike hishab/titu_stt_bn_conformer_large, CC-BY-NC-4.0).
CONFORMER_MODEL_NAME=bengaliAI/BanglaConformer

# Hugging Face checkpoint to load when ENGINE=wav2vec2.
WAV2VEC2_MODEL_NAME=SayedShaun/bangla-wave2vec2-unigram

# Hugging Face checkpoint to load when ENGINE=whisper. Apache-2.0. Whisper-
# medium (769M params) -- meaningfully heavier than the other two engines
# (autoregressive generate(), not CTC), needs more GPU headroom.
WHISPER_MODEL_NAME=bengaliAI/tugstugi_bengaliai-regional-asr_whisper-medium

# "cuda" or "cpu". Must match the hardware LitServe actually runs on.
ACCELERATOR=cuda

# GPU count. Pinned rather than "auto": LitServe's "auto" shells out to
# `nvidia-smi -L`, which can silently report 0 devices even when
# torch.cuda.is_available() is True, crashing server startup.
DEVICES=1

# Worker processes per GPU. Each holds a full model copy in GPU memory;
# 2 is conservative for ~8-12GB GPUs — lower it if you hit OOM.
WORKERS_PER_DEVICE=2

# Max utterances batched together per inference call.
TRANSCRIBE_BATCH_SIZE=4

# Expected input sample rate (Hz) for /predict.
SAMPLE_RATE=16000

# Longer audio is split into non-overlapping segments of this length and
# rejoined. The conformer checkpoint trained on clips up to ~18.5s, so 18.0
# fits it well; wav2vec2's raw-waveform CNN frontend + large transformer
# stack is far more memory-hungry per second of audio, so on small (~4GB)
# GPUs set this much lower (e.g. 8.0) when ENGINE=wav2vec2. Whisper pads
# every segment to a fixed 30s window internally regardless of this value,
# so it must stay under 30.0 when ENGINE=whisper but otherwise has no
# memory reason to go lower.
MAX_SEGMENT_SECONDS=18.0

# How long (seconds) a request may wait in LitServe's internal queue before
# it's dropped with a 504. LitServe's own default (30s) is tuned for fast CTC
# engines; whisper's autoregressive generate() is slow enough that concurrent
# requests queue past 30s under load even with nothing actually wrong.
LITSERVE_TIMEOUT=120.0

# Rewrite spelled-out Bengali numbers in transcripts as digits ("আটশো দুই"
# -> "802"). The checkpoint always spells numbers out while real transcripts
# use digits; measured on the 1322-clip FLEURS benchmark this cut corpus WER
# from 0.1541 to 0.1370, and 0.2811 to 0.1898 on digit-bearing references.
# Set false to get the model's raw wording.
ITN_ENABLED=true

# Public port for the gateway (main.py). LitServe's own host/port are
# hardcoded elsewhere (run_litserve.py, src/api/client.py) — not configurable.
GATEWAY_PORT=8000

# Live-caption chunk length (seconds) — final caption latency, hard cuts, no overlap.
LIVE_CC_CHUNK_SECONDS=3.0

# How often (seconds) to re-transcribe the in-progress chunk for interim
# captions. GPU cost scales as chunk_seconds / this value. 0 disables interim captions.
LIVE_CC_INTERIM_INTERVAL_SECONDS=1.0

# Raw PCM sample rate (Hz) the live-cc client actually streams — must match
# the client, not SAMPLE_RATE above.
LIVE_CC_INPUT_SAMPLE_RATE=16000

LOG_LEVEL=INFO
LOG_DIR=.logs
