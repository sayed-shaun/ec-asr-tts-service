# Hugging Face checkpoint for ASR. Apache-2.0. sherpa-onnx streaming
# Zipformer2 transducer: ONNX, CPU-only, and the only kind of ASR that decodes
# incrementally. Its file layout in
# the repo is a ZipformerLayout in src/litserver/zipformer/layouts.py.
ZIPFORMER_MODEL_NAME=alphacep/vosk-model-small-streaming-bn

# onnxruntime execution provider for ASR: "cpu" or "cuda". This is a property
# of the installed sherpa-onnx wheel, NOT of ACCELERATOR below -- the PyPI
# wheel bundles a CPU-only libonnxruntime, so "cuda" there silently falls back
# to CPU rather than failing. Using it needs a CUDA wheel from k2-fsa's index
# built against this image's CUDA/cuDNN pair.
#
# Keep "cpu" for live calls: the checkpoint is small and decodes a few hundred
# ms per pass, where kernel-launch overhead can exceed the compute, and the GPU
# is wanted for TTS, whose latency a caller actually hears. CUDA is worth
# measuring on the batch /predict path, where one encoder pass covers a batch.
ZIPFORMER_PROVIDER=cpu

# Build arg, not a runtime setting: which sherpa-onnx wheel the image installs.
# Empty means the PyPI CPU wheel. To A/B CUDA, set the exact local version from
# https://k2-fsa.github.io/sherpa/onnx/cuda.html matching this image's CUDA and
# cuDNN (the litserver base is cuda12.8/cudnn9, so the cuda12.cudnn9 variant),
# then rebuild and set ZIPFORMER_PROVIDER=cuda. Both must change: the wheel
# supplies the provider, the setting selects it.
#
#   SHERPA_ONNX_CUDA_VERSION=1.13.5+cuda12.cudnn9.onnxruntime1.27.1
SHERPA_ONNX_CUDA_VERSION=

# Mount the text-to-speech LitAPI alongside ASR in the same LitServe process.
# Off by default: ASR alone is pure CPU (sherpa-onnx under ZIPFORMER_PROVIDER),
# so the GPU is a deliberate opt-in. While off, POST /v1/audio/speech answers
# 503 and no torch model is loaded.
TTS_ENABLED=false

# Hugging Face checkpoint to load when TTS_ENABLED. Apache-2.0. Prompted with
# a natural-language voice description rather than a speaker id, so the voice
# list (src/litserver/parler/voices.py) needs no extra checkpoints. ~2.6GB in
# bf16 on the GPU, times WORKERS_PER_DEVICE.
TTS_MODEL_NAME=ai4bharat/indic-parler-tts

# Voice used when a request doesn't name one; see parler/voices.py.
TTS_VOICE=Aditi

# Text longer than this is split on clause boundaries and synthesized chunk by
# chunk, then rejoined with short gaps. Parler is autoregressive: long prompts
# both slow generation and degrade prosody, and it truncates past its token
# budget.
TTS_MAX_CHARS=160

# "cuda" or "cpu". Must match the hardware LitServe actually runs on.
ACCELERATOR=cuda

# GPU count. Pinned rather than "auto": LitServe's "auto" shells out to
# `nvidia-smi -L`, which can silently report 0 devices even when
# torch.cuda.is_available() is True, crashing server startup.
DEVICES=1

# Worker processes per GPU. Each holds a full model copy in GPU memory;
# 2 is conservative for ~8-12GB GPUs — lower it if you hit OOM.
WORKERS_PER_DEVICE=2

# Max utterances batched together per inference call.
TRANSCRIBE_BATCH_SIZE=4

# Expected input sample rate (Hz) for /predict.
SAMPLE_RATE=16000

# How long (seconds) a request may wait in LitServe's internal queue before
# it's dropped with a 504. LitServe's own default (30s) is tuned for fast
# recognizers; Parler's autoregressive generation is slow enough that
# concurrent TTS requests queue past 30s under load with nothing actually wrong.
LITSERVE_TIMEOUT=120.0

# Rewrite spelled-out Bengali numbers in transcripts as digits ("আটশো দুই"
# -> "802"). The checkpoint always spells numbers out while real transcripts
# use digits; measured on the 1322-clip FLEURS benchmark this cut corpus WER
# from 0.1541 to 0.1370, and 0.2811 to 0.1898 on digit-bearing references.
# Set false to get the model's raw wording.
ITN_ENABLED=true

# Where the gateway reaches the LitServe model server. The default is the
# compose service name, which only resolves inside that network; set it
# explicitly when the two run apart.
LITSERVE_BASE_URL=http://litserver:8000

# Port the model server binds. Keep it in step with LITSERVE_BASE_URL above.
LITSERVE_PORT=8000

# Origins allowed to call the gateway cross-origin. The chatbot UI can now
# call /asr/upload and /v1/audio/speech directly instead of proxying.
CORS_ALLOW_ORIGINS=*

# Public port for the gateway (main.py). LitServe's own host/port are
# hardcoded elsewhere (run_litserve.py, src/api/client.py) — not configurable.
GATEWAY_PORT=8000

LOG_LEVEL=INFO
LOG_DIR=.logs
